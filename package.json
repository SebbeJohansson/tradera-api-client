{
  "name": "tradera-api",
  "description": "Typed TypeScript client for the Tradera REST API",
  "version": "4.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SebbeJohansson/tradera-api-client"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "25.0.6",
    "openapi-typescript": "7.13.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "build": "yarn clean && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "generate": "tsx scripts/generate-client.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "update-contract": "tsx scripts/update-contract.ts && yarn generate"
  }
}
